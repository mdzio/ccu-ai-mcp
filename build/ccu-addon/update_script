#!/bin/sh

# Add-on information
ADDON_ID=ccu-ai-mcp
ADDON_NAME="CCU-AI-MCP"
ADDON_DESCR_EN="CCU-AI-MCP is an MCP server for connecting an artificial intelligence (AI) to OpenCCU."
ADDON_DESCR_DE="CCU-AI-MCP ist ein MCP-Server zur Anbindung einer künstlichen Intelligenz (KI) an OpenCCU."

# Directories
ADDON_DIR=/usr/local/addons/${ADDON_ID}
ETC_DIR=/usr/local/etc
RCD_DIR=/usr/local/etc/config/rc.d
WWW_DIR=/usr/local/etc/config/addons/www/${ADDON_ID}

# Logging to syslog is currently not supported by the CCU during the install process.

if [ "$1" = "" ]; then
  echo "${ADDON_NAME} Add-On is not for CCU1"
  lcdtool "Add-On is not for CCU1   "
  exit 1
elif [ "$1" = "CCU2" ]; then
  echo "Installing on CCU2"
  mount -t ubifs ubi1:user /usr/local
# A CCU3 currently masquerades as OpenCCU/RaspberryMatic. CCU3 is currently not defined, but it can happen. 
elif [ "$1" == "HM-RASPBERRYMATIC" -o "$1" == "CCU3" ]; then
  echo "Installing on CCU3/RaspberryMatic"
  mount /usr/local 2> /dev/null
fi

# Stop ccu-ai-mcp, if already installed.
if [ -f $RCD_DIR/${ADDON_ID} ]; then
  echo "Previous installation detected"
  $RCD_DIR/${ADDON_ID} stop
fi

# Create directories
mkdir -p ${ADDON_DIR}
chmod 755 ${ADDON_DIR}
mkdir -p ${RCD_DIR}
chmod 755 ${RCD_DIR}
mkdir -p ${WWW_DIR}
chmod 755 ${WWW_DIR}

# Copy addon
cp -af addon/* ${ADDON_DIR}/

# Copy startup script
cp -af rc.d/* ${RCD_DIR}/

# Copy www directory
cp -af www/* ${WWW_DIR}/

# Install default configuration, if it does not already exist. An existing
# configuration is preserved across updates so that the generated apiKey and
# any user changes are kept.
CONFIG=${ADDON_DIR}/config.toml
if [ ! -f ${CONFIG} ]; then
  cp -af config.default.toml ${CONFIG}
fi

# Generate a unique API key, if it does not already exist.
if grep -Eq "^apiKey\s*=\s*'GENERATE IT'" ${CONFIG} 2>/dev/null; then
  API_KEY=$(head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 32)
  sed -Ei "s/^apiKey\s*=\s*'GENERATE IT'$/apiKey = '${API_KEY}'/" ${CONFIG}
fi

# Add menu entry
cp -af addon/update_hm_addons.tcl ${ADDON_DIR}/
${ADDON_DIR}/update_hm_addons.tcl -a ${ADDON_ID} -name "${ADDON_NAME}" -url /addons/${ADDON_ID}/config.cgi -de "${ADDON_DESCR_DE}" -en "${ADDON_DESCR_EN}"

sync
echo "Installed"

# Force a reboot on RM and CCU3, CCU2 always reboots after addon installation.
if [ "$1" = "HM-RASPBERRYMATIC" ] || [ "$1" = "CCU3" ]; then
  exit 10
fi

exit 0
